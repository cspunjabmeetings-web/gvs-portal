---
// spec: F25-AC1 (/contact, /how-to-order), E01 (/api/settings: work_start, work_end), intent 12.4 (asal value hamesha Settings se;
//       build par likhi nahin). JS na chale ya request fail ho to aam matn "kaam ke auqaat" hi rehta hai.
---
<span data-work-hours>kaam ke auqaat</span>
<script>
  const fmt = (hhmm: string) => {
    const m = /^(\d{2}):(\d{2})$/.exec(hhmm);
    if (!m) return null;
    const h = Number(m[1]);
    return `${h % 12 || 12}:${m[2]} ${h < 12 ? 'AM' : 'PM'}`;
  };
  fetch('/api/settings')
    .then((r) => (r.ok ? (r.json() as Promise<{ settings?: { work_start?: string; work_end?: string } }>) : null))
    .then((d) => {
      const a = fmt(d?.settings?.work_start ?? '');
      const b = fmt(d?.settings?.work_end ?? '');
      if (!a || !b) return;
      for (const el of document.querySelectorAll<HTMLElement>('[data-work-hours]')) el.textContent = `roz ${a} se ${b} tak (Pakistan waqt)`;
    })
    .catch(() => undefined);
</script>
