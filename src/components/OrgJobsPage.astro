---
// spec: S23 /jobs/ppsc|fpsc|nts (F18-AC3): idara kya hai, form kaise bharein, test ka pattern (matn slot se, 300+ alfaz), us idare ki khuli jobs,
//       FAQ + FAQPage schema (intent page list), Ad "Haan" (top + bottom), title/description seo.json. Owner ka faisla 13b-3a: aam rehnumai, owner tasdeeq kare.
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AdSlot from './AdSlot.astro';
import FAQ from './FAQ.astro';
import JobCard from './JobCard.astro';
import seo from '../data/seo.json';
import { orgJobs, type JobCard as Card } from '../lib/jobs';
import { pkDate } from '../lib/pkdate';
import { breadcrumbSchema, faqSchema, jsonLd } from '../lib/schema-ld';

interface Props {
  path: '/jobs/ppsc' | '/jobs/fpsc' | '/jobs/nts';
  /** DB mein `org` (PPSC/FPSC/NTS) */
  org: string;
  fullName: string;
  officialUrl: string;
  faq: { q: string; a: string }[];
}
const { path, org, fullName, officialUrl, faq } = Astro.props;
const meta = seo.pages[path];
const now = new Date();
const today = pkDate(now);
let jobs: Card[] = [];
let failed = false;
try {
  jobs = await orgJobs(env.DB, org, now);
} catch {
  failed = true;
}
const base = Astro.site ?? Astro.url;
const ld = [
  breadcrumbSchema([
    { name: 'Home', url: new URL('/', base).href },
    { name: 'Jobs', url: new URL('/jobs', base).href },
    { name: org, url: new URL(path, base).href },
  ]),
  faqSchema(faq),
];
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base title={meta.title} description={meta.description}>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLd(ld)} />
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Jobs', href: '/jobs' }, { label: org }]} />
    <h1 class="mt-3">{org} jobs</h1>
    <p class="mt-1 text-muted">{fullName}</p>
    <AdSlot slot="top" />

    <section aria-labelledby="org-jobs-h" data-org-jobs={org}>
      <h2 id="org-jobs-h">{org} ki khuli jobs <span class="tabular text-muted">({jobs.length})</span></h2>
      {
        failed ? (
          <p class="mt-3 rounded-xl bg-surface-2 p-4" role="alert">Jobs abhi load nahin huin. Thori der baad page dobara kholen.</p>
        ) : jobs.length === 0 ? (
          <p class="mt-3 rounded-xl bg-surface-2 p-4" data-jobs-empty>
            Abhi {org} ki koi khuli job yahan nahin. <a href="/jobs">Doosri jobs dekhein</a>.
          </p>
        ) : (
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {jobs.map((j) => (
              <li>
                <JobCard job={j} today={today} />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <div class="mt-8 flex max-w-[68ch] flex-col gap-6 [&_h2]:mb-2 [&_p+p]:mt-3" data-org-content>
      <slot />
    </div>

    <p class="mt-6 max-w-[68ch] rounded-xl bg-surface-2 p-4 text-sm">
      GVS Academy niji academy hai, {org} nahin. Har maloomat ki tasdeeq {org} ki official website
      <a href={officialUrl} target="_blank" rel="noopener nofollow" class="break-all">{officialUrl.replace(/^https:\/\//, '')}</a> se karein.
    </p>

    <FAQ items={faq} />
    <AdSlot slot="bottom" />
  </div>
</Base>
