---
// spec: S01, F01-AC1, F01-AC2, F01-AC3 (streak ki yaad dihani), F01-AC5, F01-AC6, F01-AC7; F17-AC5 (Aap ke liye); F21-AC1, F21-AC8
//       F01-AC4 taza jobs (E07, Qadam 13b)
import Base from '../layouts/Base.astro';
import DoorCard from '../components/DoorCard.astro';
import DailyTestCard from '../components/DailyTestCard.astro';
import HomeForYou from '../components/HomeForYou.tsx';
import LatestJobs from '../components/LatestJobs.tsx';
import ProductCard from '../components/ProductCard.astro';
import OrderSteps from '../components/OrderSteps.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import seo from '../data/seo.json';
import { getProduct, type Product } from '../lib/catalog';
import RefundLine from '../components/RefundLine.astro';
import { jsonLd, organizationSchema, websiteSchema } from '../lib/schema-ld';

const meta = seo.pages['/'];
const popular = ['vu-smart', 'mcq-pack', 'past-papers', 'cv-cover']
  .map((id) => getProduct(id))
  .filter((p): p is Product => Boolean(p));

const faq = [
  {
    q: 'Order kaise karein?',
    a: 'Cheez chunein aur zaroori tafseel bharein (maslan course code), phir naam aur WhatsApp number de kar order WhatsApp par bhejein. Sign up ki zaroorat nahin.',
  },
  {
    q: 'Payment kaise hoti hai?',
    a: 'WhatsApp par JazzCash ya Easypaisa se. Payment ka screenshot isi chat par bhejein; hum tasdeeq kar ke order shuru karte hain.',
  },
  {
    q: 'File kab milegi?',
    a: 'Payment milne ke baad taqreeban 2 ghante mein, kaam ke auqaat (subah 9 se raat 10 baje) ke andar. Order ka darja aur waqt "Order track karein" par dekhein.',
  },
  {
    q: 'Kya GVS sarkari idara hai?',
    a: 'Nahin. GVS Academy niji academy hai. Sarkari fee alag hoti hai aur official challan par jati hai.',
  },
];
const ldBase = (Astro.site ?? Astro.url).href;
const ldUrl = new URL(Astro.url.pathname, ldBase).href;
const ld = [organizationSchema(ldBase, meta.description), websiteSchema(ldBase)];
---
<Base title={meta.title} description={meta.description}>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLd(ld)} />
  <section class="container-page pt-8 pb-4">
    <h1>Aap kon hain?</h1>
    <p class="mt-2 text-muted max-w-[68ch]">Apna rasta chunein. Tayyari bhi, form bhi, kaam bhi: ek jagah.</p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <DoorCard icon="book" title="Job ki tayyari" line="Rozana muft MCQs, mock tests, notes, past papers aur current affairs." href="/job-prep" />
      <DoorCard icon="cap" title="VU Corner" line="Course code likhein aur Quick, Smart, Complete ya Topper pack chunein." href="/vu" />
      <DoorCard icon="paper" title="Board Classes" line="9th se 12th: class, mazmoon aur chapters ke mutabiq test paper." href="/board" />
      <DoorCard
        icon="brief"
        title="Kaam karwana hai"
        line="CV, job apply, ya sarkari scheme ka form: hum kar dein."
        links={[
          { label: 'Career Desk', href: '/career' },
          { label: 'Sarkari Services', href: '/sarkari-services' },
        ]}
      />
    </div>
  </section>

  <section class="container-page py-4">
    <DailyTestCard />
    <HomeForYou client:idle />
  </section>

  <div class="container-page" data-latest-jobs-host>
    <LatestJobs client:idle />
  </div>

  <section class="container-page py-4" aria-labelledby="popular-heading">
    <h2 id="popular-heading" class="mb-4">Mashhoor packs</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {popular.map((p) => <ProductCard product={p} />)}
    </div>
    <RefundLine />
    <p class="mt-4"><a href="/plans">Saari qeematein dekhein</a></p>
  </section>

  <div class="container-page">
    <OrderSteps />

    <section class="my-8 max-w-[68ch]" aria-labelledby="about-heading">
      <h2 id="about-heading">GVS Academy kya karti hai</h2>
      <p class="mt-3">
        GVS Academy ek niji academy hai jo teen kaam karti hai. Pehla, job tests ki tayyari: har din 10 naye MCQs ka muft test,
        mazmoon-war practice, muft mock tests aur notes. Doosra, tayyar material: VU ke course code ke mutabiq packs, board pattern
        ke test papers, solved past papers aur mahana current affairs. Teesra, aap ka kaam: CV aur cover letter banana, online job
        ka form bharna, aur sarkari scheme ke form mein madad.
      </p>
      <p class="mt-3">
        Har qeemat is portal par saaf likhi hai, aur order se pehle WhatsApp par namoona maang sakte hain. Order ke liye sign up nahin karna
        parta; sirf naam aur WhatsApp number. Order pehle hamare paas mehfooz hota hai, phir WhatsApp par tayyar message khulta hai.
        Payment JazzCash ya Easypaisa se hoti hai, aur aap order number se har waqt dekh sakte hain ke payment mili ya nahin aur
        file kab tak aaye gi.
      </p>
      <p class="mt-3">
        Hum sarkari idara nahin hain, aur naukri ya pass hone ka wada nahin karte. Hum tayyari aur sahih form mein madad karte hain.
        Sarkari fee hamesha alag hoti hai aur official challan par jati hai. Jobs ki maloomat sirf official ishtihar se li jati
        hai, official link ke sath. Muft test rozana dein, apni streak banayen, aur jahan madad chahiye wahan hum se WhatsApp par
        rabta karein.
      </p>
    </section>

    <FAQ items={faq} />
    <AdSlot slot="bottom" />
  </div>
</Base>
