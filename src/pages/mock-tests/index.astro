---
// spec: S18 /mock-tests (on-demand, D1): muft mocks ki list (naam, sawal, waqt) + paid series ki peshkash (F15-AC1); intent page list: Ad "Haan" (top + bottom)
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import ProductCard from '../../components/ProductCard.astro';
import DailyTestCard from '../../components/DailyTestCard.astro';
import seo from '../../data/seo.json';
import { publicMocks, type MockCard } from '../../lib/mocks';
import { getProduct } from '../../lib/catalog';
import RefundLine from '../../components/RefundLine.astro';

export const prerender = false;

const meta = seo.pages['/mock-tests'];
let mocks: MockCard[] = [];
let failed = false;
try {
  mocks = await publicMocks(env.DB);
} catch {
  failed = true;
}
const series = getProduct('mock-series');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base title={meta.title} description={meta.description}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Job ki tayyari', href: '/job-prep' }, { label: 'Mock tests' }]} />
    <h1 class="mt-3">Muft mock tests</h1>
    <AdSlot slot="top" />
    <p class="max-w-[68ch]">
      Asal test jaisa tajurba, phone par. Ulti ginti ke timer ke sath sawal hal karein, "baad mein dekhein" ka nishan lagayen, aur aakhir mein
      apna score dekhein. Sign up ki zaroorat nahin.
    </p>

    {
      failed ? (
        <p class="mt-5 rounded-xl bg-surface-2 p-4" role="alert">Mock tests abhi load nahin hue. Thori der baad page dobara kholen.</p>
      ) : mocks.length === 0 ? (
        <p class="mt-5 rounded-xl bg-surface-2 p-4" data-mocks-empty>Muft mock tests jald aayenge. Tab tak aaj ka muft test dein.</p>
      ) : (
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" data-mock-cards>
          {mocks.map((m) => (
            <li>
              <a href={`/mock-tests/${m.slug}`} class="flex h-full flex-col gap-2 rounded-xl border border-border bg-surface p-4 no-underline" data-mock-card={m.slug}>
                <span class="font-semibold text-text">{m.name}</span>
                <span class="text-sm text-primary">
                  <span class="tabular">{m.questions}</span> sawal · <span class="tabular">{m.minutes}</span> minute
                </span>
                {m.summary && <span class="text-sm text-muted">{m.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <section class="mt-8 max-w-[68ch]" aria-labelledby="how-heading">
      <h2 id="how-heading">Mock test kaise chalta hai</h2>
      <ol class="mt-3 flex list-decimal flex-col gap-1 pl-5">
        <li>Test chunein aur usool parh kar "Shuru karein" dabayen.</li>
        <li>Har sawal ka jawab chunein; neeche "Sawal list" se kisi bhi sawal par ja sakte hain.</li>
        <li>Waqt khatam hone se pehle "Jama karein" dabayen, warna test khud jama ho jaye ga.</li>
        <li>Page band ho jaye to wapas aa kar wahin se jari rakhein.</li>
      </ol>
    </section>

    <section class="mt-8">
      <DailyTestCard />
    </section>

    {
      series && (
        <section class="mt-8" aria-labelledby="series-heading">
          <h2 id="series-heading" class="mb-2">Har hafte naye tests chahiye?</h2>
          <p class="mb-4 max-w-[68ch] text-muted">Paid mock test series WhatsApp group mein chalti hai. Order ke liye sirf naam aur WhatsApp number.</p>
          <div class="grid gap-4 md:grid-cols-2">
            <ProductCard product={series} />
          </div>
          <RefundLine />
        </section>
      )
    }

    <AdSlot slot="bottom" />
  </div>
</Base>
