---
// spec: S16 /mcqs/<mazmoon> (on-demand, D1 + /api/mcqs): 10 sawalon ka set (quiz UI), "Agla set", set ke baad `result` ad (F14-AC2..AC4);
//       intent page list: Ad "Set ke baad" (quiz ke dauran koi ad nahin, F22-AC3). Ghalat mazmoon = 404. Pehla set page ke sath (SEO + foran).
// View: route file lookup karti hai aur na mile to NotFound (Qadam 14); yeh sirf mili hui cheez dikhata hai.
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import Practice from '../../components/quiz/Practice.tsx';
import { practiceSet } from '../../lib/practice';
import { getProduct, formatPrice, productPage } from '../../lib/catalog';

interface Props {
  subject: string;
  slug: string;
}
const { subject, slug } = Astro.props;
const initial = await practiceSet(env.DB, subject, 0);
const p = getProduct('mcq-pack');
const pack = p && p.price !== null ? { name: p.name, line: p.includes[0] ?? '', price: formatPrice(p.price), href: productPage(p.id) } : null;
const title = `${subject} MCQs: muft practice, jawab aur tashreeh | GVS Academy`;
const description = `${subject} ke ${initial.total ? initial.total + ' ' : ''}muft MCQs, 10-10 ke sets mein. Har sawal ka foran jawab aur tashreeh, bina sign up.`.slice(0, 160);
---
<Base title={title} description={description} noindex={initial.total === 0}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'MCQs', href: '/mcqs' }, { label: subject }]} />
    <h1 class="mt-3">{subject} MCQs</h1>
    <p class="mt-2 max-w-[68ch] text-muted">
      {subject} ke sawal 10-10 ke sets mein. Option dabate hi sahih jawab aur tashreeh nazar aaye gi. Ghalti nazar aaye to "Ghalti batayen" dabayen.
    </p>
    <div class="mt-5 max-w-xl">
      <Practice client:load subject={subject} slug={slug} initial={initial} pack={pack} />
      <noscript>
        {
          initial.items.length > 0 && (
            <ol class="mt-4 flex flex-col gap-3">
              {initial.items.map((q) => (
                <li class="rounded-xl border border-border bg-surface p-3">
                  <p class="font-semibold">{q.question}</p>
                  <p class="text-sm">Jawab: {q.options[q.answerIndex]}</p>
                </li>
              ))}
            </ol>
          )
        }
      </noscript>
    </div>
    <div class="max-w-xl" data-result-ad hidden>
      <AdSlot slot="result" />
    </div>
    <p class="mt-6"><a href="/mcqs" class="inline-flex min-h-[44px] items-center">Doosre mazameen</a></p>
  </div>
</Base>
