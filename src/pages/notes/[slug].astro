---
// spec: S21 /notes/<slug> (on-demand, D1), F16-AC1..AC5, design.md 6.8: Breadcrumbs → H1 → khulasa → matn (≤ 68ch) → `inline` ad (teesre hisse ke baad)
//       Qadam 14: na mile = 404, mitaya = 410 — dono par saade text ki jagah poora NotFound page. Asal page `components/views/NoteView.astro`.
import { env } from 'cloudflare:workers';
import NotFound from '../../components/NotFound.astro';
import NoteView from '../../components/views/NoteView.astro';
import { notePage } from '../../lib/notes';

export const prerender = false;

const page = await notePage(env.DB, Astro.params.slug ?? '');
const status = page === 'gone' ? 410 : !page ? 404 : 200;
if (status !== 200) Astro.response.status = status;
Astro.response.headers.set('Cache-Control', status === 200 ? 'public, max-age=0, s-maxage=300' : 'public, max-age=0, s-maxage=60');
---
{
  page && page !== 'gone' ? (
    <NoteView page={page} />
  ) : (
    <NotFound kind={status === 410 ? 'gone' : 'missing'} what="Yeh note" back={{ label: 'Doosre muft notes', href: '/notes' }} />
  )
}
