---
// spec: S32 /vu-mock/<code>, F30-AC3 (Midterm/Final, Test 1, 2, 3…), F30-AC6 (title/description; canonical Base se, bina ?term); ad nahin
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import VuCourse from '../quiz/VuCourse.tsx';
import { activeProducts } from '../../lib/catalog';
import type { VuCourse as Course } from '../../lib/vu-public';

interface Props {
  course: Course;
  ids: { mid: number[]; final: number[] };
  term: string | null;
}
const { course: c, term, ids } = Astro.props;
// Catalog se (usool 7); qeemat wale VU packs
const packs = activeProducts()
  .filter((x) => x.door === 'vu' && x.price !== null)
  .map((x) => ({ id: x.id, name: x.name, price: x.price as number, includes: x.includes }));
const ready = c.mid + c.final > 0;
// Link mein term ho to wohi; warna jis mein sawal hon (pehle Midterm)
const start = term === 'mid' || term === 'final' ? term : c.mid > 0 || c.final === 0 ? 'mid' : 'final';
const title = `${c.code} Midterm aur Final MCQs: muft test | GVS`;
const description = `${c.code} ${c.name}: muft online mock test, Midterm aur Final ke MCQs, timer aur har sawal ka jawab. Bina sign up.`.slice(0, 155);
---
<Base title={title} description={description} noindex={!ready}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'VU Mock Test', href: '/vu-mock' }, { label: c.code }]} />
    <header class="mt-3 rounded-2xl bg-primary p-5 text-on-primary">
      <h1>{c.code} mock test</h1>
      <p class="mt-1 break-words">{c.name}</p>
      <p class="mt-2 text-sm">Virtual University ke students ke liye muft practice. GVS niji academy hai.</p>
    </header>
    <div class="mt-5 max-w-xl">
      <VuCourse client:load code={c.code} ids={ids} start={start} packs={packs} />
      <noscript><p class="mt-4 rounded-xl bg-surface-2 p-4">Test dene ke liye browser mein JavaScript chalu karein.</p></noscript>
    </div>
    <p class="mt-6"><a href="/vu-mock" class="inline-flex min-h-[44px] items-center">Doosre VU courses</a></p>
  </div>
</Base>
