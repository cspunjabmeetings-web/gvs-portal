---
// spec: S27 /track (static + client), F06-AC1..AC9; AC9: noindex, koi ad nahin (intent 13)
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrackApp from '../components/TrackApp.tsx';
import seo from '../data/seo.json';

const meta = seo.pages['/track'];
---
<Base title={meta.title} description={meta.description} noindex>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Order track karein' }]} />
    <h1 class="mt-3">Order track karein</h1>
    <p class="mt-2 max-w-[68ch] text-muted">
      Order number aur apne WhatsApp number ke aakhri 4 hindse likhein. Aap ko order ka darja aur delivery ka waqt nazar aaye ga.
    </p>
    <div class="mt-5 max-w-lg">
      <TrackApp client:load />
      <noscript>
        <p class="mt-4 rounded-xl bg-surface-2 p-4">Order dekhne ke liye browser mein JavaScript chalu karein, ya WhatsApp par apna order number bhej dein.</p>
      </noscript>
    </div>
  </div>
</Base>
