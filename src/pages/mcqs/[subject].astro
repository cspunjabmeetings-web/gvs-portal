---
// spec: S16 /mcqs/<mazmoon> (on-demand, D1 + /api/mcqs): 10 sawalon ka set (quiz UI), "Agla set", set ke baad `result` ad (F14-AC2..AC4);
//       Qadam 14: ghalat mazmoon = 404, saade text ki jagah poora NotFound page. Asal page `components/views/PracticeView.astro`.
import { env } from 'cloudflare:workers';
import NotFound from '../../components/NotFound.astro';
import PracticeView from '../../components/views/PracticeView.astro';
import { subjectBySlug } from '../../lib/practice';

export const prerender = false;

const slug = (Astro.params.subject ?? '').toLowerCase();
const subject = await subjectBySlug(env.DB, slug);
if (!subject) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', subject ? 'public, max-age=0, s-maxage=300' : 'public, max-age=0, s-maxage=60');
---
{
  subject ? (
    <PracticeView subject={subject} slug={slug} />
  ) : (
    <NotFound what="Yeh mazmoon" back={{ label: 'Saare mazameen', href: '/mcqs' }} />
  )
}
