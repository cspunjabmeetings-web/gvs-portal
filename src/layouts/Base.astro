---
// spec: 3.1, 6.1 (har page ka dhancha; AnnouncementBar sab se upar, F10-AC3), F21-AC1 (title/description/canonical), F21-AC9 (lang="en"),
//       F21-AC6 (Open Graph/Twitter card; default 1200x630 og.png, job ki tasveer ho to wohi), F23-AC3 (analytics deferred; admin par nahin),
//       F26-AC1 (manifest, icons, install ka mauqa yaad rakhna), F26-AC2 (service worker NAHIN)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartBar from '../components/CartBar.tsx';
import AnnouncementBar from '../components/AnnouncementBar.tsx';

interface Props {
  title: string;
  description: string;
  /** false sirf admin jaisi screens ke liye (spec 6.1) */
  chrome?: boolean;
  noindex?: boolean;
  /** F21-AC6: share ki tasveer (poora ya site-relative URL); warna default og.png */
  image?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
}

const { title, description, chrome = true, noindex = false, image, ogType = 'website' } = Astro.props;
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const og = image ?? { src: '/images/og.png', width: 1200, height: 630, alt: 'GVS Academy: muft MCQs, mock tests, notes aur jobs' };
const ogImage = new URL(og.src, base).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="GVS Academy" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta property="og:locale" content="en_PK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0F5132" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D1410" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/images/logo.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="GVS" />
    {/* F16-AC5: page ka JSON-LD (sirf schema-ld.ts ka jsonLd) */}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only-focusable bg-accent text-on-accent px-4 py-2">Seedha mazmoon par jayen</a>
    {/* spec 6.1: elaan sab se upar, admin par nahin */}
    {
      chrome && (
        <>
          {/* 17b CLS: dhancha HTML mein pehle se (chhupa); neeche ka script cache se paint se pehle bharta hai */}
          <div role="note" aria-label="Elaan" class="bg-accent text-on-accent" data-announcement hidden>
            <p class="container-page py-2 text-center text-sm font-semibold" />
          </div>
          <script is:inline>
            try {
              var gvsAnn = JSON.parse(sessionStorage.getItem('gvs.settings.v2') || 'null');
              var gvsAnnText = gvsAnn && gvsAnn.s && gvsAnn.s.announcement_text;
              if (typeof gvsAnnText === 'string' && gvsAnnText) {
                var gvsAnnBar = document.querySelector('[data-announcement]');
                gvsAnnBar.firstElementChild.textContent = gvsAnnText;
                gvsAnnBar.hidden = false;
              }
            } catch (e) {}
          </script>
          <AnnouncementBar client:idle />
        </>
      )
    }
    {chrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer />}
    {/* spec 6.1: CartBar har page par, admin par nahin (chrome=false) */}
    {chrome && <CartBar client:idle />}
    <script>
      // F23: page ke khud chalne wale events + GA4 (deferred; PUBLIC_GA_ID khali = band). Admin par analytics nahin.
      // F23-AC5: Meta Pixel bhi (khali ID = band); /track par nahin kyun ke URL mein order number hota hai.
      import { PUBLIC_GA_ID, PUBLIC_META_PIXEL_ID } from 'astro:env/client';
      import { autoEvents, initAnalytics, initMetaPixel } from '../lib/analytics';
      import { captureInstall } from '../lib/install';
      captureInstall();
      if (!location.pathname.startsWith('/admin')) {
        autoEvents();
        initAnalytics(PUBLIC_GA_ID);
        if (location.pathname.replace(/\/+$/, '') !== '/track') initMetaPixel(PUBLIC_META_PIXEL_ID);
      }
    </script>
  </body>
</html>
