---
// spec: F02-AC1, F02-AC2, F02-AC3, F02-AC4, F02-AC5; design.md 5 ProductCard
// "Order list mein daalein" Qadam 4 (cart) mein chalu hoga; abhi band.
import { PUBLIC_WHATSAPP_FALLBACK } from 'astro:env/client';
import { formatPrice, isOrderable, type Product } from '../lib/catalog';
import { waLink } from '../lib/phone';
import FieldInput from './FieldInput.astro';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
  /** Pehle se tay value (maslan board class page par className); khana nahin, sirf likha hua */
  preset?: Record<string, string>;
  /** Yeh khane page par ek jagah hain (maslan VU course code); card mein dobara nahin */
  sharedFields?: string[];
}

const { product: p, headingLevel = 'h3', preset = {}, sharedFields = [] } = Astro.props;
const Heading = headingLevel;
const orderable = isOrderable(p);
const ownFields = p.fields.filter((f) => !(f.key in preset) && !sharedFields.includes(f.key));
const presetFields = p.fields.filter((f) => f.key in preset);
const contactUrl = waLink(PUBLIC_WHATSAPP_FALLBACK, `Assalam o Alaikum GVS Academy, mujhe "${p.name}" ke bare mein maloomat chahiye.`);
const fid = (key: string) => `${p.id}-${key}`;
---
{p.active && (
  <article class="flex flex-col gap-4 bg-surface border border-border rounded-xl p-4 shadow-[0_1px_2px_rgb(0_0_0/0.06)]" data-product-id={p.id}>
    <header class="flex items-start justify-between gap-3">
      <Heading class="text-lg font-semibold leading-snug">{p.name}</Heading>
      {orderable ? (
        <p class="tabular text-xl font-bold text-primary whitespace-nowrap" aria-label={`Qeemat ${formatPrice(p.price as number)}`}>
          {formatPrice(p.price as number)}
        </p>
      ) : (
        <p class="text-sm font-semibold text-accent-text whitespace-nowrap">Qeemat: rabta karein</p>
      )}
    </header>

    {p.govtFeeExtra && (
      <p class="text-sm rounded-lg bg-surface-2 px-3 py-2">Qeemat mein sarkari fee shamil nahin. Sarkari fee alag, official challan par.</p>
    )}

    <ul class="flex flex-col gap-1.5">
      {p.includes.map((item) => (
        <li class="flex gap-2">
          <svg class="mt-1 shrink-0 text-correct" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    {p.sample && (
      <a href={p.sample} class="inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg border border-primary text-primary font-semibold no-underline hover:bg-primary-soft">
        Namoona dekhein
      </a>
    )}

    {orderable ? (
      <form
        class="flex flex-col gap-3"
        novalidate
        data-add-to-cart={p.id}
        data-name={p.name}
        data-price={p.price}
        data-govt-fee={p.govtFeeExtra ? '1' : undefined}
        data-shared-fields={sharedFields.join(',') || undefined}
      >
        {presetFields.map((f) => (
          <p class="text-sm"><span class="text-muted">{f.label}:</span>{' '}<strong>{preset[f.key]}</strong>
            <input type="hidden" name={f.key} value={preset[f.key]} />
          </p>
        ))}
        {ownFields.map((f) => <FieldInput field={f} id={fid(f.key)} />)}
        {/* Bina JS ke band; script chalu karta hai (cart JS se chalti hai, spec 9.8) */}
        <button
          type="submit"
          disabled
          data-add-button
          class="min-h-[48px] rounded-lg bg-primary text-on-primary font-semibold px-4 hover:bg-primary-hover disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Order list mein daalein
        </button>
        <p class="hidden text-sm font-medium rounded-lg px-3 py-2" role="status" aria-live="polite" data-cart-status></p>
      </form>
    ) : (
      <a
        href={contactUrl}
        rel="noopener"
        class="inline-flex items-center justify-center min-h-[48px] rounded-lg bg-primary text-on-primary font-semibold no-underline px-4 hover:bg-primary-hover"
      >
        WhatsApp par rabta karein
      </a>
    )}
  </article>
)}

<script>
  // spec: F03-AC1 (foran, bina network), F03-AC3, F03-AC4, F03-AC6, F02-AC2 (ghalti ka paigham)
  import { addToCart, CART_MSG } from '../lib/cart';
  import { validateFieldValue } from '../lib/validators';

  // <select> bhi yahi cheezein rakhta hai (value, required, checkValidity, setCustomValidity, dataset)
  type Field = HTMLInputElement;

  function show(form: HTMLFormElement, text: string, ok: boolean) {
    const el = form.querySelector<HTMLElement>('[data-cart-status]');
    if (!el) return;
    el.textContent = (ok ? '✓ ' : '✕ ') + text;
    el.className = `text-sm font-medium rounded-lg px-3 py-2 ${ok ? 'bg-correct-bg text-correct' : 'bg-wrong-bg text-wrong'}`;
  }

  function fieldsOf(form: HTMLFormElement): Field[] {
    const own = [...form.querySelectorAll<Field>('input[name], select[name]')];
    const shared = (form.dataset.sharedFields ?? '')
      .split(',')
      .filter(Boolean)
      .map((k) => document.querySelector<Field>(`[data-shared-field-host="${k}"] [name="${k}"]`))
      .filter((x): x is Field => Boolean(x));
    return [...shared, ...own];
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-add-button]')) b.disabled = false;

  // Ghalti ka custom paigham likhte hi saaf
  document.addEventListener('input', (e) => {
    const t = e.target as Field;
    if (t && 'setCustomValidity' in t) t.setCustomValidity('');
  });

  document.addEventListener('submit', (e) => {
    const form = (e.target as HTMLElement).closest<HTMLFormElement>('form[data-add-to-cart]');
    if (!form) return;
    e.preventDefault();

    const fields: Record<string, string> = {};
    for (const el of fieldsOf(form)) {
      el.setCustomValidity('');
      const tooLong = !validateFieldValue(el.value).ok;
      if (!el.checkValidity() || tooLong || (el.required && !el.value.trim())) {
        el.setCustomValidity(el.dataset.msg ?? 'Yeh khana sahih bharein.');
        el.reportValidity();
        el.focus();
        show(form, el.dataset.msg ?? 'Yeh khana sahih bharein.', false);
        return;
      }
      if (el.value.trim()) fields[el.name] = el.value.trim();
    }

    const res = addToCart({
      id: form.dataset.addToCart!,
      name: form.dataset.name ?? '',
      price: Number(form.dataset.price ?? 0),
      govtFeeExtra: form.dataset.govtFee === '1',
      fields,
    });
    show(form, res.ok ? CART_MSG.added : CART_MSG[res.reason], res.ok);
  });
</script>
