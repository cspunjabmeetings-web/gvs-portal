---
// spec: F01-AC5, F02-AC1 (order ke 4 qadam), intent 9.2
interface Props {
  heading?: string;
}
const { heading = 'Order ke 4 qadam' } = Astro.props;
const steps = [
  { t: 'Cheez chunein', d: 'Pack ya service chunein aur zaroori tafseel bharein, maslan course code ya class.' },
  { t: 'Naam aur number dein', d: 'Sirf naam aur WhatsApp number. Sign up ya password nahin.' },
  { t: 'WhatsApp par bhejein', d: 'Tayyar message WhatsApp par khulta hai. Order number aap ke paas mehfooz rehta hai.' },
  { t: 'Payment aur delivery', d: 'JazzCash ya Easypaisa se payment. File ya kaam WhatsApp par aata hai; darja "Order track karein" par dekhein.' },
];
---
<section class="my-8" aria-labelledby="steps-heading">
  <h2 id="steps-heading" class="mb-4">{heading}</h2>
  <ol class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="flex gap-3 rounded-xl border border-border bg-surface p-4">
        <span class="tabular inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary font-bold" aria-hidden="true">{i + 1}</span>
        <span>
          <span class="block font-semibold">{s.t}</span>
          <span class="block text-sm text-muted">{s.d}</span>
        </span>
      </li>
    ))}
  </ol>
  <p class="mt-3 text-sm"><a href="/how-to-order">Order ka poora tareeqa dekhein</a></p>
</section>
