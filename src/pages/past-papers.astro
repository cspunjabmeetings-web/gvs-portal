---
// spec: S12 (/past-papers: kis post ke papers, namoona, order: post/test ka naam), F02-AC1; intent 13 (Ad: Haan)
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import seo from '../data/seo.json';
import { getProduct } from '../lib/catalog';

const meta = seo.pages['/past-papers'];
const product = getProduct('past-papers');
const faq = [
  {
    q: 'Kis kis post ke papers milte hain?',
    a: 'Order mein apni post ya test ka naam likhein, maslan "PPSC Educator BPS-14". Agar us post ke papers hamare paas na hon to hum WhatsApp par payment se pehle bata dete hain.',
  },
  {
    q: 'Kya yeh asal papers hain?',
    a: 'Yeh pichhle imtihanaat mein aaye sawalon par mabni hain, GVS ke apne hal aur tashreeh ke sath. Yeh kisi idare ka official material nahin.',
  },
  {
    q: 'Kya agle test mein yahi sawal aayenge?',
    a: 'Koi nahin keh sakta. Past papers se pattern aur ahem topics samajh aate hain; tayyari poore syllabus ki zaroori hai.',
  },
];
---
<Base title={meta.title} description={meta.description}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Job ki tayyari', href: '/job-prep' }, { label: 'Solved past papers' }]} />
    <h1 class="mt-3">Solved past papers: apni post ke mutabiq</h1>
    <p class="mt-2 text-muted max-w-[68ch]">Jis post ya test ki tayyari kar rahe hain, us ke past papers hal aur tashreeh ke sath, PDF mein.</p>

    <AdSlot slot="top" />

    <div class="grid gap-6 lg:grid-cols-[1fr_360px] lg:items-start">
      <section class="max-w-[68ch]" aria-labelledby="why-heading">
        <h2 id="why-heading">Past papers kyun zaroori hain</h2>
        <p class="mt-3">
          Har idare aur har post ke test ka apna mizaj hota hai. Kahin General Knowledge zyada hoti hai, kahin mazmoon ke sawal. Past
          papers parhne se pehle hi andaza ho jata hai ke sawal kis qism ke aate hain, kaun se topics baar baar aate hain, aur kitna
          waqt kis hisse ko dena hai.
        </p>
        <p class="mt-3">
          GVS ke solved past papers mein sawal ke sath sahih jawab aur mukhtasar tashreeh hoti hai, taake sirf jawab yaad na karein
          balke wajah bhi samjhein. Isi se milte julte naye sawal bhi hal ho jate hain. Hal aur tashreeh GVS ki apni hai; kisi
          academy ya kitab ka scan nahin.
        </p>
        <p class="mt-3">
          Order mein apni post ya test ka naam saaf likhein, maslan idara, post aur scale. Agar kisi khaas post ke papers hamare paas
          maujood na hon, to hum payment se pehle WhatsApp par bata dete hain, taake aap ka paisa zaya na ho.
        </p>
        <p class="mt-3">
          Past papers ko mock test ki tarah istemal karein: waqt laga kar hal karein, phir jawab milayen. Roz ki practice ke liye
          <a href="/daily-test">aaj ka muft test</a>, mazmoon-war <a href="/mcqs">MCQs</a>, aur poore <a href="/mock-tests">mock tests</a>
          bhi dekhein. Har test ki asal maloomat aur syllabus hamesha official ishtihar se lein.
        </p>
      </section>

      {product && (
        <aside aria-label="Order" class="lg:sticky lg:top-4">
          <ProductCard product={product} />
        </aside>
      )}
    </div>

    <TrustStrip />
    <FAQ items={faq} />
    <AdSlot slot="bottom" />
  </div>
</Base>
