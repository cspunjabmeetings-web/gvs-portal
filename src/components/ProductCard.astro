---
// spec: F02-AC1, F02-AC2, F02-AC3, F02-AC4, F02-AC5; design.md 5 ProductCard
// "Order list mein daalein" Qadam 4 (cart) mein chalu hoga; abhi band.
import { PUBLIC_WHATSAPP_FALLBACK } from 'astro:env/client';
import { formatPrice, fieldMessage, isOrderable, type Product } from '../lib/catalog';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}

const { product: p, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const orderable = isOrderable(p);
const intl = '92' + PUBLIC_WHATSAPP_FALLBACK.replace(/^0/, '');
const contactUrl = `https://wa.me/${intl}?text=${encodeURIComponent(`Assalam o Alaikum GVS Academy, mujhe "${p.name}" ke bare mein maloomat chahiye.`)}`;
const fid = (key: string) => `${p.id}-${key}`;
---
{p.active && (
  <article class="flex flex-col gap-4 bg-surface border border-border rounded-xl p-4 shadow-[0_1px_2px_rgb(0_0_0/0.06)]" data-product-id={p.id}>
    <header class="flex items-start justify-between gap-3">
      <Heading class="text-lg font-semibold leading-snug">{p.name}</Heading>
      {orderable ? (
        <p class="tabular text-xl font-bold text-primary whitespace-nowrap" aria-label={`Qeemat ${formatPrice(p.price as number)}`}>
          {formatPrice(p.price as number)}
        </p>
      ) : (
        <p class="text-sm font-semibold text-accent-text whitespace-nowrap">Qeemat: rabta karein</p>
      )}
    </header>

    {p.govtFeeExtra && (
      <p class="text-sm rounded-lg bg-surface-2 px-3 py-2">Qeemat mein sarkari fee shamil nahin. Sarkari fee alag, official challan par.</p>
    )}

    <ul class="flex flex-col gap-1.5">
      {p.includes.map((item) => (
        <li class="flex gap-2">
          <svg class="mt-1 shrink-0 text-correct" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    {p.sample && (
      <a href={p.sample} class="inline-flex items-center justify-center min-h-[44px] px-4 rounded-lg border border-primary text-primary font-semibold no-underline hover:bg-primary-soft">
        Namoona dekhein
      </a>
    )}

    {orderable ? (
      <form class="flex flex-col gap-3" data-add-to-cart={p.id}>
        {p.fields.map((f) => (
          <div class="flex flex-col gap-1">
            <label for={fid(f.key)} class="text-sm font-medium">{f.label}{f.required && <span aria-hidden="true"> *</span>}</label>
            {f.type === 'select' ? (
              <select id={fid(f.key)} name={f.key} required={f.required} class="min-h-[44px] rounded-lg border border-border bg-surface px-3 text-text">
                <option value="">Chunein</option>
                {f.options?.map((o) => <option value={o}>{o}</option>)}
              </select>
            ) : (
              <input
                id={fid(f.key)}
                name={f.key}
                type={f.type === 'number' ? 'text' : f.type}
                inputmode={f.type === 'number' ? 'numeric' : undefined}
                required={f.required}
                pattern={f.pattern?.replace(/^\^/, '').replace(/\$$/, '')}
                title={fieldMessage(f)}
                placeholder={f.example ? `maslan ${f.example}` : undefined}
                autocomplete="off"
                class="peer min-h-[44px] rounded-lg border border-border bg-surface px-3 text-text placeholder:text-muted [&:not(:placeholder-shown):invalid]:border-wrong [&:not(:placeholder-shown):invalid]:border-2"
              />
            )}
            {f.pattern && f.type !== 'select' && (
              <p class="hidden text-sm text-wrong peer-[:not(:placeholder-shown):invalid]:flex gap-1 items-start" data-field-error={f.key}>
                <span aria-hidden="true">✕</span>
                <span>{fieldMessage(f)}</span>
              </p>
            )}
          </div>
        ))}
        <button
          type="submit"
          disabled
          class="min-h-[48px] rounded-lg bg-primary text-on-primary font-semibold px-4 disabled:opacity-60 disabled:cursor-not-allowed"
          title="Order list jald chalu hogi"
        >
          Order list mein daalein
        </button>
      </form>
    ) : (
      <a
        href={contactUrl}
        rel="noopener"
        class="inline-flex items-center justify-center min-h-[48px] rounded-lg bg-primary text-on-primary font-semibold no-underline px-4 hover:bg-primary-hover"
      >
        WhatsApp par rabta karein
      </a>
    )}
  </article>
)}
