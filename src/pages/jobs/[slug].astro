---
// spec: S24 /jobs/<slug> (on-demand, D1), F18-AC2 (ishtihar ka link, taleem, documents, tareeqa number wari, akhri tareekh, official link,
//       Qadam 14: na mile = 404, mitaya = 410 — dono par saade text ki jagah poora NotFound page. Asal page `components/views/JobView.astro`.
import { env } from 'cloudflare:workers';
import NotFound from '../../components/NotFound.astro';
import JobView from '../../components/views/JobView.astro';
import { jobBySlug } from '../../lib/jobs';

export const prerender = false;

const now = new Date();
const page = await jobBySlug(env.DB, Astro.params.slug ?? '', now);
const status = page === 'gone' ? 410 : !page ? 404 : 200;
if (status !== 200) Astro.response.status = status;
Astro.response.headers.set('Cache-Control', status === 200 ? 'public, max-age=0, s-maxage=300' : 'public, max-age=0, s-maxage=60');
---
{
  page && page !== 'gone' ? (
    <JobView page={page} now={now} />
  ) : (
    <NotFound kind={status === 410 ? 'gone' : 'missing'} what="Yeh job" fem back={{ label: 'Doosri khuli jobs', href: '/jobs' }} />
  )
}
