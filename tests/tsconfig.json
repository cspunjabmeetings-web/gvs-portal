{
  // spec: 13.6 DEPS (@types/node, owner ka CHANGE REQUEST 17 Nov 2026), 10.1: tests ki type jaanch.
  // Root tsconfig tests/ ko bahar rakhta hai (website ke code mein Node types nahin); yahan Node + Workers dono.
  "extends": "../tsconfig.json",
  "include": ["./**/*.ts", "../vitest.config.ts"],
  "exclude": [],
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true,
    // scripts/*.mjs ki types nahin parhni (golden scope.test ka @ts-expect-error isi par tika hai)
    "allowJs": false
  }
}
