---
// spec: S15 /mcqs (on-demand, D1): mazameen ke cards + sawalon ki ginti, packs (F14-AC1); intent page list: Ad "Haan" (top + bottom)
// mcq-pack ka productPage() = /mcqs — is liye us ka order card yahin.
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import ProductCard from '../../components/ProductCard.astro';
import DailyTestCard from '../../components/DailyTestCard.astro';
import seo from '../../data/seo.json';
import { subjectCards } from '../../lib/practice';
import { getProduct, type Product } from '../../lib/catalog';
import RefundLine from '../../components/RefundLine.astro';

export const prerender = false;

const meta = seo.pages['/mcqs'];
let cards: Awaited<ReturnType<typeof subjectCards>> = [];
let failed = false;
try {
  cards = await subjectCards(env.DB);
} catch {
  failed = true;
}
const total = cards.reduce((n, c) => n + c.count, 0);
const packs = ['mcq-pack', 'past-papers', 'current-affairs'].map((id) => getProduct(id)).filter((p): p is Product => Boolean(p));
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base title={meta.title} description={meta.description}>
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Job ki tayyari', href: '/job-prep' }, { label: 'MCQs' }]} />
    <h1 class="mt-3">MCQs practice: mazmoon chunein</h1>
    <AdSlot slot="top" />
    <p class="max-w-[68ch]">
      Mazmoon chunein aur 10-10 sawalon ke sets hal karein. Har sawal ka jawab foran milta hai, tashreeh ke sath. Sirf jaanche hue sawal dikhaye
      jate hain. Sign up ki zaroorat nahin.
    </p>
    {total > 0 && <p class="mt-2 text-sm text-muted">Abhi kul <span class="tabular">{total}</span> sawal maujood hain; naye aate rehte hain.</p>}

    {
      failed ? (
        <p class="mt-5 rounded-xl bg-surface-2 p-4" role="alert">Mazameen abhi load nahin hue. Thori der baad page dobara kholen.</p>
      ) : (
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" data-subject-cards>
          {cards.map((c) => (
            <li>
              <a href={`/mcqs/${c.slug}`} class="flex min-h-[64px] items-center justify-between gap-3 rounded-xl border border-border bg-surface p-4 no-underline" data-subject={c.slug}>
                <span class="font-semibold text-text">{c.subject}</span>
                <span class={`whitespace-nowrap text-sm ${c.count ? 'text-primary' : 'text-muted'}`}>
                  {c.count ? <><span class="tabular" data-count>{c.count}</span> sawal</> : 'Jald aayenge'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <section class="mt-8">
      <DailyTestCard />
    </section>

    <section class="mt-8" aria-labelledby="packs-heading">
      <h2 id="packs-heading" class="mb-2">Zyada sawal chahiye?</h2>
      <p class="mb-4 max-w-[68ch] text-muted">Apne mazmoon ya test ke liye chune hue MCQs aur hal shuda papers WhatsApp par PDF mein.</p>
      <div class="grid gap-4 md:grid-cols-2">
        {packs.map((p) => <ProductCard product={p} />)}
      </div>
      <RefundLine />
    </section>

    <AdSlot slot="bottom" />
  </div>
</Base>
