---
// spec: S22 /jobs (on-demand, D1): khuli jobs ginti ke sath, idare ka filter, band neeche (F18-AC1, AC4), design.md 6.9; intent page list: Ad "Haan"
//       (top + bottom), schema BreadcrumbList. Owner ke faislay (13b): filter `?idara=` link chips (bina JS); band sirf pichhle 30 din, ≤ 20.
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import JobCard from '../../components/JobCard.astro';
import seo from '../../data/seo.json';
import { publicJobs, CLOSED_DAYS, type JobsList } from '../../lib/jobs';
import { pkDate } from '../../lib/pkdate';
import { breadcrumbSchema, jsonLd } from '../../lib/schema-ld';

export const prerender = false;

const meta = seo.pages['/jobs'];
const now = new Date();
const today = pkDate(now);
let data: JobsList = { open: [], closed: [], orgs: [], org: null };
let failed = false;
try {
  data = await publicJobs(env.DB, now, Astro.url.searchParams.get('idara'));
} catch {
  failed = true;
}
const total = data.orgs.reduce((s, o) => s + o.count, 0);
const base = Astro.site ?? Astro.url;
const ld = breadcrumbSchema([
  { name: 'Home', url: new URL('/', base).href },
  { name: 'Jobs', url: new URL('/jobs', base).href },
]);
const chip = 'inline-flex min-h-[44px] items-center whitespace-nowrap rounded-full px-4 text-sm font-semibold no-underline';
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');
---
<Base title={meta.title} description={meta.description}>
  <script is:inline type="application/ld+json" slot="head" set:html={jsonLd(ld)} />
  <div class="container-page py-6">
    <Breadcrumbs items={[{ label: 'Jobs' }]} />
    <h1 class="mt-3">Sarkari jobs</h1>
    <AdSlot slot="top" />
    <p class="max-w-[68ch]">
      Official ishtihar se li gayi jobs: akhri tareekh, documents aur apply ka tareeqa. Khud apply karein, ya "Hum apply kar dein" dabayen aur
      hum online form bhar dein. GVS niji academy hai, sarkari idara nahin; har job ka official link zaroor dekhein.
    </p>

    {
      failed ? (
        <p class="mt-5 rounded-xl bg-surface-2 p-4" role="alert">Jobs abhi load nahin huin. Thori der baad page dobara kholen.</p>
      ) : (
        <>
          {data.orgs.length > 0 && (
            <nav class="-mx-4 mt-5 overflow-x-auto px-4 [scrollbar-width:none]" aria-label="Idare">
              <ul class="flex gap-2" data-org-chips>
                <li>
                  <a href="/jobs" class:list={[chip, !data.org ? 'bg-primary text-on-primary' : 'border border-border text-text']} aria-current={!data.org ? 'page' : undefined}>
                    Sab ({total})
                  </a>
                </li>
                {data.orgs.map((o) => (
                  <li>
                    <a
                      href={`/jobs?idara=${encodeURIComponent(o.org)}`}
                      class:list={[chip, data.org?.toLowerCase() === o.org.toLowerCase() ? 'bg-primary text-on-primary' : 'border border-border text-text']}
                      aria-current={data.org?.toLowerCase() === o.org.toLowerCase() ? 'page' : undefined}
                      data-org-chip={o.org}
                    >
                      {o.org} ({o.count})
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <section class="mt-6" aria-labelledby="open-h">
            <h2 id="open-h">
              Khuli jobs <span class="tabular text-muted" data-open-count>({data.open.length})</span>
              {data.org && <span class="text-muted"> · {data.org}</span>}
            </h2>
            {data.open.length === 0 ? (
              <p class="mt-3 rounded-xl bg-surface-2 p-4" data-jobs-empty>
                {data.org ? `${data.org} ki koi khuli job abhi nahin.` : 'Abhi koi khuli job nahin. Naye ishtihar aate hi yahan nazar aayenge.'}
              </p>
            ) : (
              <ul class="mt-3 grid gap-3 sm:grid-cols-2" data-open-jobs>
                {data.open.map((j) => (
                  <li>
                    <JobCard job={j} today={today} />
                  </li>
                ))}
              </ul>
            )}
          </section>

          {data.closed.length > 0 && (
            <section class="mt-8" aria-labelledby="closed-h">
              <h2 id="closed-h" class="text-muted">Band ho chuki</h2>
              <p class="mt-1 text-sm text-muted">Pichhle {CLOSED_DAYS} din mein jin ki akhri tareekh guzar gayi.</p>
              <ul class="mt-3 grid gap-3 sm:grid-cols-2" data-closed-jobs>
                {data.closed.map((j) => (
                  <li>
                    <JobCard job={j} today={today} />
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )
    }

    <section class="mt-8 max-w-[68ch]" aria-labelledby="orgs-h">
      <h2 id="orgs-h">Idaron ke bare mein</h2>
      <ul class="mt-3 flex flex-col gap-1">
        <li><a href="/jobs/ppsc" class="inline-flex min-h-[44px] items-center">PPSC: Punjab Public Service Commission</a></li>
        <li><a href="/jobs/fpsc" class="inline-flex min-h-[44px] items-center">FPSC: Federal Public Service Commission</a></li>
        <li><a href="/jobs/nts" class="inline-flex min-h-[44px] items-center">NTS: National Testing Service</a></li>
        <li><a href="/apply-service" class="inline-flex min-h-[44px] items-center">Apply service: hum form kaise bharte hain</a></li>
      </ul>
    </section>

    <AdSlot slot="bottom" />
  </div>
</Base>
